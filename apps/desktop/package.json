{
  "name": "@novel-writer/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && node -e \"require('fs').renameSync('dist/main/preload.js','dist/main/preload.cjs')\"",
    "dev:renderer": "vite build",
    "dev": "npm run dev:main && npm run dev:renderer",
    "build": "npm run dev:main && vite build",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@novel-writer/core": "*",
    "@novel-writer/editor": "*",
    "@novel-writer/export": "*",
    "@novel-writer/ui-shared": "*",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^6.0.0"
  }
}
